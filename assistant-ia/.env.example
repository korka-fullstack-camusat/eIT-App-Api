# Copier ce fichier en .env puis compléter. Ne jamais committer le .env.

# Clé API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optionnel : modèle et niveau d'effort (low | medium | high | xhigh | max)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Connexions PostgreSQL vers des rôles EN LECTURE SEULE (scripts/create_readonly_role.sql)
INVENTORY_DB_URL=postgresql://assistant_ro:MOT_DE_PASSE@HOTE:5432/NOM_BASE_INVENTAIRE
RH_DB_URL=postgresql://assistant_ro:MOT_DE_PASSE@HOTE:5432/NOM_BASE_RH
PARC_IT_DB_URL=postgresql://assistant_ro:MOT_DE_PASSE@HOTE:5434/parc_it

# Comptes autorisés, séparés par des virgules : identifiant:hash_bcrypt
# Générer une entrée : python scripts/hash_password.py prenom.nom
ASSISTANT_USERS=
